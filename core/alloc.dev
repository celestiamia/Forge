package std.alloc

# Bump allocator backed by a compiler-emitted arena.
#
# The hosted runtime provides `_dev_alloc`, which advances a static bump
# pointer over a 64 KiB `.bss` arena and returns the previous value, and
# `_dev_free`, which is a no-op (the bump arena never reclaims memory).  They
# are declared `extern` because they are emitted by the compiler's tiny
# runtime rather than defined in Forge.
extern def _dev_alloc(size: uint64) -> ptr[char]
extern def _dev_free(p: ptr[char]) -> void

# Allocate `size` bytes from the bump arena.  Returns a pointer to the new
# block, or a null pointer if the arena is exhausted.
pub def alloc(size: uint64) -> ptr[char]:
    return _dev_alloc(size)

# Release a previously allocated block.  The bump arena does not reclaim
# memory, so this is currently a no-op; it exists for API compatibility.
pub def free(p: ptr[char]) -> void:
    _dev_free(p)