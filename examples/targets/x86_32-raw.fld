# x86_32 flat binary kernel target for a 16-bit boot-to-32-bit chain
# (mirrors the ForgeOS32 kernel link `examples/os32/os32-kernel.fld`).
#
# Usage: forgec kernel.dev -o kernel.raw --linker examples/targets/x86_32-raw.fld
#
# A stage-2 loader is responsible for placing the emitted bytes at LOAD
# (default 0x100000) and transferring control to ENTRY (_start).  The
# compiler fixes up absolute string-address literals against LOAD, so keep
# this in sync with your loader's actual kernel mapping.

ARCH x86_32
FORMAT raw
HOSTED false
ENTRY _start
LOAD 0x100000
