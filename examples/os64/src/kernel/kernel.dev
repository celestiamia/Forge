package os64.kernel

# ForgeOS64 kernel: 64-bit long mode, pure Forge.
#
# Compiled as a freestanding x86_64 raw image (see os64-kernel.fld) and entered
# through the stage-2 loader's long-mode switch: 64-bit code/data segments
# (CS=0x08, DS/ES/SS=0x10), paging on (1:1 identity map of 0..1 GiB), running
# at the physical LOAD address 0x100000.  There is no BIOS any more: output goes
# to COM1 (port 0x3F8) via the `_dev_outb`/`_dev_inb` port-I/O helpers the
# x86_64 freestanding runtime emits, and the kernel halts with `_dev_halt`.

extern def _dev_outb(port: u16, val: u8) -> void
extern def _dev_inb(port: u16) -> u8
extern def _dev_halt() -> void

@freestanding
pub def _start() -> void:
    serial_init()
    puts("ForgeOS64: hello from 64-bit long mode\n")
    _dev_halt()

def serial_init() -> void:
    _dev_outb(0x3F8 + 1, 0)       # IER: no interrupts
    _dev_outb(0x3F8 + 3, 0x80)    # LCR: enable divisor latch
    _dev_outb(0x3F8, 1)           # divisor low (115200 baud)
    _dev_outb(0x3F8 + 1, 0)       # divisor high
    _dev_outb(0x3F8 + 3, 0x03)    # LCR: 8N1, latch off
    _dev_outb(0x3F8 + 2, 0xC7)    # FCR: enable + clear FIFOs

def serial_putc(c: char) -> void:
    var lsr: u8 = _dev_inb(0x3F8 + 5)
    while (lsr & 0x20) == 0:
        lsr = _dev_inb(0x3F8 + 5)
    _dev_outb(0x3F8, c as u8)

def puts(msg: ptr[char]) -> void:
    unsafe:
        var p: ptr[char] = msg
        var c: char = p[0]
        while c != 0:
            serial_putc(c)
            p = p + 1
            c = p[0]
