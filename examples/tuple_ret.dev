package test

def pair() -> (int64, int64):
    var t: (int64, int64)
    t.0 = 3
    t.1 = 4
    return t

def triple() -> (int64, int64, int64):
    return (1, 2, 3)

def sum3(t: (int64, int64, int64)) -> int64:
    return t.0 + t.1 + t.2

def swap(t: (int64, int64)) -> (int64, int64):
    var r: (int64, int64)
    r.0 = t.1
    r.1 = t.0
    return r

pub def main() -> int64:
    if pair().0 != 3 || pair().1 != 4:
        return 1
    var (a, b) = pair()
    if a != 3 || b != 4:
        return 2
    var (c, d, e) = triple()
    if c != 1 || d != 2 || e != 3:
        return 3
    if sum3((1, 2, 3)) != 6:
        return 4
    var (x, y) = swap((7, 8))
    if x != 8 || y != 7:
        return 5
    return a + b